  "exhibits": [
    {
      "id": "reg-m2-tbs1-ex1",
      "title": "Scenarios",
      "html": "<p>A: The principal directly instructs an agent to buy supplies. B: The principal publicly represents that an agent can place ordinary orders, and a supplier reasonably relies. C: The principal knowingly accepts an unauthorized agreement under circumstances satisfying ratification. D: A seller’s breach causes a $12,000 loss, but $3,000 could reasonably have been avoided.</p>"
    },
    {
      "id": "reg-m2-tbs1-ex2",
      "title": "Assumptions",
      "html": "<p>Apply ordinary agency and expectation-damage principles. There are no special statutory remedies, exceptions, or additional losses.</p>"
    }
  ],
  "explanation": "<h3>Authority in A</h3><p>The principal directly authorized the agent.</p><h3>Authority in B</h3><p>The principal’s manifestations created reasonable third-party reliance.</p><h3>Doctrine in C</h3><p>Knowing adoption can bind the principal when requirements are met.</p><h3>Recoverable loss after the stated mitigation adjustment</h3><p>$12,000 − $3,000 reasonably avoidable loss = $9,000.</p>"
