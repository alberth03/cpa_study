    {
      "id": "tcp-m3-tbs1-ex1",
      "title": "C corporation alternative",
      "html": "<p>Income $300,000; entity tax 21%; all after-tax earnings distributed; owner dividend rate 15%.</p>"
    },
    {
      "id": "tcp-m3-tbs1-ex2",
      "title": "Pass-through alternative",
      "html": "<p>The same $300,000 is taxed once at the owner’s supplied 30% rate and fully distributed. Ignore state, employment, QBI, and all other effects.</p>"
    }
