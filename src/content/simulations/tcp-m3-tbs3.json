  "exhibits": [
    {
      "id": "tcp-m3-tbs3-ex1",
      "title": "Tax alternatives",
      "html": "<p>A $100,000 deduction can be taken now at a 32% marginal rate or next year at 24%. Ignore time value, limitations, and other tax effects.</p>"
    },
    {
      "id": "tcp-m3-tbs3-ex2",
      "title": "Business effect",
      "html": "<p>Taking the deduction now requires $3,000 of incremental business cost that is not otherwise included in the comparison. Ignore tax effects of that cost.</p>"
    }
  ],
  "explanation": "<h3>Current-year tax saving</h3><p>$100,000 × 32% = $32,000.</p><h3>Next-year tax saving</h3><p>$100,000 × 24% = $24,000.</p><h3>Additional nominal tax saving from acceleration</h3><p>$32,000 − $24,000 = $8,000.</p><h3>Net benefit after the stated incremental business cost</h3><p>$8,000 − $3,000 = $5,000.</p>"
