  "exhibits": [
    {
      "id": "reg-m3-tbs3-ex1",
      "title": "Asset record",
      "html": "<p>Original cost $140,000; tax depreciation allowed or allowable $90,000. The equipment is Section 1245 property.</p>"
    },
    {
      "id": "reg-m3-tbs3-ex2",
      "title": "Sale terms",
      "html": "<p>Cash proceeds $120,000; qualifying selling costs $10,000. No nonrecognition provision applies. Recapture is limited to recognized gain and prior depreciation.</p>"
    }
  ],
  "explanation": "<h3>Adjusted basis</h3><p>$140,000 − $90,000 = $50,000.</p><h3>Net amount realized</h3><p>$120,000 − $10,000 = $110,000.</p><h3>Recognized gain</h3><p>$110,000 − $50,000 = $60,000.</p><h3>Ordinary Section 1245 recapture</h3><p>The $60,000 gain is less than prior depreciation of $90,000.</p>"
