  "exhibits": [
    {
      "id": "tcp-m1-tbs1-ex1",
      "title": "Option exercise",
      "html": "<p>1,500 nonqualified options are exercised at $12 when stock value is $32. The spread is ordinary compensation; basis includes exercise cash and compensation.</p>"
    },
    {
      "id": "tcp-m1-tbs1-ex2",
      "title": "Estimated tax",
      "html": "<p>Required annual payment is the lesser of 90% of $60,000 projected current tax and 110% of $40,000 prior tax. Qualifying withholding is $30,000. Ignore timing differences among installments.</p>"
    }
  ],
  "explanation": "<h3>Option compensation income</h3><p>1,500 × ($32 − $12) = $30,000.</p><h3>Stock basis after exercise</h3><p>$18,000 exercise cash plus $30,000 compensation = $48,000.</p><h3>Required annual tax payment</h3><p>The lesser of $54,000 and $44,000 is $44,000.</p><h3>Additional estimated payments after withholding</h3><p>$44,000 required less $30,000 withholding = $14,000.</p>"
