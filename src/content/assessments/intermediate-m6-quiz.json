      "moduleId": 6,
      "topic": "Revenue Recognition Overview",
      "prompt": "Which statement best describes the core principle of revenue recognition?",
      "choices": [
        {
          "id": "intermediate-m6-q1-a0",
          "text": "Revenue is recognized whenever cash is received"
        },
        {
          "id": "intermediate-m6-q1-a1",
          "text": "Revenue is recognized when or as promised goods or services are transferred to customers"
        },
        {
          "id": "intermediate-m6-q1-a2",
          "text": "Revenue is recognized when management prepares financial statements"
        },
        {
          "id": "intermediate-m6-q1-a3",
          "text": "Revenue is recognized only at year-end"
        }
      ],
      "correctChoiceId": "intermediate-m6-q1-a1",
      "explanation": "Revenue is recognized when or as performance obligations are satisfied by transferring promised goods or services to customers.",
