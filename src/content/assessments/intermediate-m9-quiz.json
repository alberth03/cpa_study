    {
      "id": "intermediate-m9-q2",
      "courseId": "intermediate",
      "moduleId": 9,
      "topic": "Temporary Differences",
      "prompt": "Which characteristic best distinguishes a temporary difference from a permanent difference?",
      "choices": [
        {
          "id": "intermediate-m9-q2-a0",
          "text": "A temporary difference has future tax consequences that reverse"
        },
        {
          "id": "intermediate-m9-q2-a1",
          "text": "A temporary difference never affects future periods"
        },
        {
          "id": "intermediate-m9-q2-a2",
          "text": "A permanent difference always creates a deferred tax asset"
        },
        {
          "id": "intermediate-m9-q2-a3",
          "text": "A permanent difference always creates a deferred tax liability"
        }
      ],
      "correctChoiceId": "intermediate-m9-q2-a0",
      "explanation": "Temporary differences create future taxable or deductible amounts. Permanent differences do not reverse and therefore do not create deferred tax assets or liabilities.",
      "difficulty": "foundation",
      "metadata": {
        "section": "intermediate",
        "blueprintYear": 2026,
