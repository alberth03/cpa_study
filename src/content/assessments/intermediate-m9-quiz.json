      "courseId": "intermediate",
      "moduleId": 9,
      "topic": "Book vs Taxable Income",
      "prompt": "Which statement about book income and taxable income is correct?",
      "choices": [
        {
          "id": "intermediate-m9-q1-a0",
          "text": "They must always be identical"
        },
        {
          "id": "intermediate-m9-q1-a1",
          "text": "They can differ because financial reporting and tax rules may recognize items differently"
        },
        {
          "id": "intermediate-m9-q1-a2",
          "text": "Taxable income always equals operating cash flow"
        },
        {
          "id": "intermediate-m9-q1-a3",
          "text": "Book income is calculated using tax law"
        }
      ],
      "correctChoiceId": "intermediate-m9-q1-a1",
      "explanation": "Financial accounting and tax rules can differ in the timing or treatment of revenues and expenses.",
      "difficulty": "foundation",
