# Use the exact externally visible origin. Production requires HTTPS.
APP_URL=http://localhost:3000
NODE_ENV=development
# Must be on a persistent volume in production; never put it inside public/.
DATABASE_PATH=./data/cpa-study.sqlite
# Local development: no emails or verification step. Production never bypasses verification.
# Use preview for local email files, or smtp for actual email delivery.
MAIL_DELIVERY=disabled
MAIL_PREVIEW_DIR=./data/mail-preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CPA Study <study@example.com>
# Enable only behind a trusted proxy that replaces client-forwarded IP headers.
TRUST_PROXY=false
